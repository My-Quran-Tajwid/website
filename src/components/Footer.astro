---
import { Image } from "astro:assets";
import siteLogo from "../assets/images/site-logo.png";
---

<footer class="bg-white py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 xl:px-0 flex flex-col gap-y-12">
    <div
      class="grid gap-y-6 sm:grid-cols-2 sm:gap-x-8 md:px-4 lg:grid-cols-4 lg:gap-x-12 lg:gap-y-0 lg:px-8"
    >
      <figure>
        <Image
          class="h-12 w-auto max-w-full object-contain object-left"
          src={siteLogo}
          alt="My Quran Tajwid"
        />
      </figure>
      <div class="flex flex-col items-start gap-y-4">
        <div class="flex flex-col items-start gap-y-1.5">
          <a
            class="whitespace-nowrap text-sm font-medium text-neutral-500"
            href="https://qurantajwid.my"
            title="Home">Home</a
          >
          <a
            class="whitespace-nowrap text-sm font-medium text-neutral-500"
            href="https://github.com/my-quran-tajwid"
            title="GitHub">GitHub</a
          >
        </div>
      </div>
    </div>
    <div class="border-b border-b-neutral-200"></div>
    <div
      class="flex flex-wrap items-center justify-between gap-4 md:px-4 lg:px-8"
    >
      <p class="text-sm font-medium text-neutral-700">
        &copy; <time datetime={String(new Date().getFullYear())}>2026</time>{
          " "
        }
        My Quran Tajwid. All rights reserved.
      </p>
    </div>
  </div>
</footer>
